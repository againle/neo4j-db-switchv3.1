# --- Azure OpenAI (single-pass generation LLM) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Neo4j (standalone `neo4j-db` container) ---
# Any host-run Python (e.g. the memgraph backend) uses this URI.
NEO4J_URI=bolt://localhost:17989
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-db-password

# --- Ollama (bge-m3 embeddings for utterance↔belief matching) ---
OLLAMA_BASE_URL=http://localhost:11437
EMBEDDING_MODEL=bge-m3:latest
# Cosine floor to draw TraineeUtterance -TRIGGERS-> Belief (topical, not paraphrase).
BELIEF_MATCH_THRESHOLD=0.42
# Prior completed turns whose trainee+client utterances join the score window.
BELIEF_CONTEXT_TURNS=2
# Cap on beliefs activated per turn.
BELIEF_MATCH_TOP_K=3
